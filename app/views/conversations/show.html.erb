<h2 class="ui center aligned icon header" style="margin-top: 2rem;">
  <i class="circular purple comments icon"></i>
  Chat with <%= @conversation.other_user(current_user).username %>
  
</h2>

<div class="ui grid centered">
  <div class="sixteen wide mobile ten wide tablet eight wide computer column">

    <!-- 🟣 Chat messages box -->
    <div class="ui raised very padded text container segment"
         id="conversation-messages"
         data-conversation-id="<%= @conversation.id %>"
         style="height: 400px; overflow-y: auto;">
      <%= render @messages %>
    </div>

    <!-- 🧪 Debugging info -->
    <p>🧪 DEBUG: conversation id = <%= @conversation.id %></p>
    <p>🧪 DEBUG: message class = <%= @message.class.name rescue 'nil' %></p>

    <!-- 🟣 Message form -->
    <div class="ui form reply-form" style="margin-top: 1rem;">
      <%= form_with(
            url: conversation_messages_path(@conversation),
            model: @message,
            remote: true,
            html: { id: "private-message-form" }
          ) do |f| %>
        <div class="field">
          <%= f.text_area :body, placeholder: "Type your message...", rows: 2, class: "ui purple input" %>
        </div>
          <%= f.button "Send", id: "send-message-button", type: "submit", class: "ui purple button" %>
      <% end %>
    </div>

  </div>
</div>
